# Storage backend: "embedded" (chDB, zero setup) or "server" (Docker or ClickHouse Cloud)
AW_BACKEND=embedded
AW_EMBEDDED_PATH=./data/agentwatch.chdb

# Server / ClickHouse Cloud (only when AW_BACKEND=server)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false
# Separate read-only user for LLM-generated hunt queries (see docs/guardrails.md)
CLICKHOUSE_HUNT_USER=
CLICKHOUSE_HUNT_PASSWORD=

# LLM: any OpenAI-compatible endpoint (AkashML, OpenAI, local). Leave key empty for mock mode.
LLM_BASE_URL=https://api.akashml.com/v1
LLM_API_KEY=
LLM_MODEL=
